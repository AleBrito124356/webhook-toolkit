# Copy to .env and fill in the values you need:  cp .env.example .env
# Every command (and the example handlers) reads ./.env; variables exported in
# your shell win over the file. Use another file with --env-file FILE.
#
# Every secret below is a placeholder (a literal X run or a plainly fake
# string). The receiver never reports a capture as "invalid" because of one:
# it shows "not checked" until you set the real secret. Explicit commands
# (verify, replay --sign, send --sign) still use a placeholder, with a warning,
# so the bundled example handlers - which fall back to the same values - work
# out of the box.

# --- Server -----------------------------------------------------------------
# Where captured events are stored (SQLite file, created on first run).
WEBHOOK_DB=webhooks.db
# Host/port the receiver + inspector listen on.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8000
# Clock-skew tolerance (seconds) for Stripe/Slack timestamped signatures.
WEBHOOK_TIMESTAMP_TOLERANCE=300

# --- Provider signing secrets -----------------------------------------------
# GitHub: the "Secret" field you set when creating the webhook (repo/org
# Settings -> Webhooks). Any long random string; you choose it.
GITHUB_WEBHOOK_SECRET=use-a-long-random-string-here

# Stripe: the signing secret shown after adding a webhook endpoint in the
# Stripe Dashboard (Developers -> Webhooks). Real values start with whsec_.
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Slack: "Signing Secret" from your app's Basic Information page
# (api.slack.com/apps -> your app -> Basic Information).
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify: the API secret key / webhook signing secret from your app settings
# (Shopify Partners -> your app -> API credentials).
SHOPIFY_WEBHOOK_SECRET=shpss_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Generic HMAC provider (optional) ----------------------------------------
# For services that sign HMAC(secret, raw body) and are not built in. Setting
# GENERIC_WEBHOOK_HEADER turns on detection and verification for them.
# GENERIC_WEBHOOK_HEADER=X-Signature
# GENERIC_WEBHOOK_ALGORITHM=sha256
# GENERIC_WEBHOOK_ENCODING=hex
# GENERIC_WEBHOOK_PREFIX=sha256=
# GENERIC_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
