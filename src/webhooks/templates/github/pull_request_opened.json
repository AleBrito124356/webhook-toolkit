{
  "provider": "github",
  "event": "pull_request.opened",
  "description": "A pull request was opened",
  "method": "POST",
  "path": "/webhooks/github",
  "headers": {
    "Content-Type": "application/json",
    "User-Agent": "GitHub-Hookshot/{{hex:7}}",
    "X-GitHub-Delivery": "{{uuid}}",
    "X-GitHub-Hook-ID": "{{int:9@hook_id}}",
    "X-GitHub-Hook-Installation-Target-Type": "repository",
    "X-GitHub-Hook-Installation-Target-ID": "{{int:9@repo_id}}",
    "X-GitHub-Event": "pull_request"
  },
  "body": {
    "action": "opened",
    "number": "{{int:3@pr_number}}",
    "pull_request": {
      "url": "https://api.github.com/repos/octo-org/hello-webhooks/pulls/{{int:3@pr_number}}",
      "id": "{{int:10}}",
      "html_url": "https://github.com/octo-org/hello-webhooks/pull/{{int:3@pr_number}}",
      "number": "{{int:3@pr_number}}",
      "state": "open",
      "locked": false,
      "draft": false,
      "title": "Add replay support for Stripe events",
      "body": "Re-signs stored events with a fresh timestamp before replaying them.",
      "user": {
        "login": "octocat",
        "id": "{{int:7@sender_id}}",
        "type": "User",
        "html_url": "https://github.com/octocat",
        "site_admin": false
      },
      "labels": [
        {
          "name": "enhancement",
          "color": "a2eeef"
        }
      ],
      "head": {
        "label": "octocat:replay-stripe",
        "ref": "replay-stripe",
        "sha": "{{hex:40}}"
      },
      "base": {
        "label": "octo-org:main",
        "ref": "main",
        "sha": "{{hex:40}}"
      },
      "merged": false,
      "mergeable": null,
      "comments": 0,
      "commits": 3,
      "additions": 120,
      "deletions": 14,
      "changed_files": 4,
      "created_at": "{{now_iso}}",
      "updated_at": "{{now_iso}}"
    },
    "repository": {
      "id": "{{int:9@repo_id}}",
      "node_id": "R_kgDO{{alnum:8@repo_node}}",
      "name": "hello-webhooks",
      "full_name": "octo-org/hello-webhooks",
      "private": false,
      "owner": {
        "login": "octo-org",
        "id": "{{int:8@org_id}}",
        "type": "Organization",
        "html_url": "https://github.com/octo-org"
      },
      "html_url": "https://github.com/octo-org/hello-webhooks",
      "description": "Sample repository used by webhook-toolkit",
      "fork": false,
      "url": "https://api.github.com/repos/octo-org/hello-webhooks",
      "default_branch": "main",
      "visibility": "public"
    },
    "sender": {
      "login": "octocat",
      "id": "{{int:7@sender_id}}",
      "type": "User",
      "html_url": "https://github.com/octocat",
      "site_admin": false
    }
  }
}
