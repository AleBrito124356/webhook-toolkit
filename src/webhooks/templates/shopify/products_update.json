{
  "provider": "shopify",
  "event": "products/update",
  "description": "A product was edited",
  "method": "POST",
  "path": "/webhooks/shopify",
  "headers": {
    "Content-Type": "application/json",
    "User-Agent": "Shopify-Captain-Hook",
    "X-Shopify-Shop-Domain": "example-shop.myshopify.com",
    "X-Shopify-API-Version": "2024-07",
    "X-Shopify-Webhook-Id": "{{uuid}}",
    "X-Shopify-Event-Id": "{{uuid}}",
    "X-Shopify-Triggered-At": "{{now_iso}}",
    "X-Shopify-Topic": "products/update"
  },
  "body": {
    "id": "{{int:13@product_id}}",
    "admin_graphql_api_id": "gid://shopify/Product/{{int:13@product_id}}",
    "title": "Webhook T-Shirt",
    "handle": "webhook-t-shirt",
    "body_html": "<p>Soft cotton tee for people who verify their signatures.</p>",
    "vendor": "Example Shop",
    "product_type": "Apparel",
    "status": "active",
    "tags": "cotton, tee",
    "created_at": "{{now_iso}}",
    "updated_at": "{{now_iso}}",
    "variants": [
      {
        "id": "{{int:13}}",
        "product_id": "{{int:13@product_id}}",
        "title": "M",
        "sku": "WH-TEE-M",
        "price": "49.90",
        "inventory_quantity": 25
      }
    ]
  }
}
